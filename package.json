{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && node --experimental-strip-types --test tests/caixin-client.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "publish:cn": "node scripts/publish-data-cloudbase.mjs collector/latest-payload.json",
    "caixin:fetch": "node --experimental-strip-types scripts/caixin-fetch.mjs",
    "caixin:sync": "node --experimental-strip-types scripts/caixin-sync.mjs",
    "test:caixin": "node --experimental-strip-types --test tests/caixin-client.test.mjs tests/caixin-mapping.test.mjs",
    "caixin:map": "node --experimental-strip-types scripts/caixin-map.mjs",
    "macro:consumer-confidence:refresh": "node --experimental-strip-types scripts/refresh-consumer-confidence.mjs --apply",
    "wind:sync": "node --experimental-strip-types scripts/wind-sync.mjs",
    "wind:index:sync": "node --experimental-strip-types scripts/sync-wind-index.mjs",
    "index:check": "node --experimental-strip-types scripts/fetch-shanghai-index.mjs",
    "index:refresh": "node --experimental-strip-types scripts/refresh-index.mjs",
    "macro:official:refresh": "node scripts/refresh-official-macro.mjs",
    "launchd:install": "bash scripts/install-launchd.sh",
    "test:automation": "node --experimental-strip-types --test tests/index-quote.test.mjs tests/index-refresh.test.mjs tests/stale-check.test.mjs tests/collector-run-guard.test.mjs tests/gdp-deflator-retry.test.mjs",
    "test:providers": "node --experimental-strip-types --test tests/caixin-client.test.mjs tests/caixin-mapping.test.mjs tests/wind-provider.test.mjs tests/wind-mcp.test.mjs",
    "collector:audit": "node --experimental-strip-types scripts/collector-run.mjs --mode=audit",
    "collector:apply": "node --experimental-strip-types scripts/collector-run.mjs --mode=apply",
    "stale:check": "node --experimental-strip-types scripts/stale-check.mjs",
    "rating:verify": "node scripts/macro-rating-draft.mjs verify",
    "rating:draft": "node scripts/macro-rating-draft.mjs build",
    "test:rating-draft": "node --test tests/macro-rating-draft.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
